rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNCIONES DE AYUDA ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Función centralizada para obtener el rol de forma segura
    function getRole() {
      // Si no hay auth, devolvemos un rol inexistente para denegar por defecto
      return isSignedIn() 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role 
        : 'GUEST';
    }

    // --- COLECCIÓN DE USUARIOS ---
    match /users/{userId} {
      // Permitir leer una ficha individual: Propietario o Administradores
      allow get: if isSignedIn() && (
        request.auth.uid == userId || 
        getRole() in ['ADMIN', 'SUPER_ADMIN']
      );
      
      // Permitir listar la colección completa: Solo Administradores
      // Al no depender de 'userId', Firestore puede validar esta regla una sola vez para toda la consulta
      allow list: if isSignedIn() && getRole() in ['ADMIN', 'SUPER_ADMIN'];
      
      // Creación: Solo para uno mismo
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // Actualización: Propietario (sin cambiar rol) o Administradores
      allow update: if isSignedIn() && (
         (request.auth.uid == userId && request.resource.data.role == resource.data.role) ||
         (request.auth.uid != userId && getRole() in ['ADMIN', 'SUPER_ADMIN'])
      );
 
      // Borrado: Solo Administradores
      allow delete: if isSignedIn() && getRole() in ['ADMIN', 'SUPER_ADMIN'];
    }

    // --- COLECCIONES DEL SISTEMA (SAAS / CORE) ---
    match /system/{document=**} {
      allow read: if true;
      allow write: if isSignedIn() && getRole() == 'SUPER_ADMIN';
    }

    // --- CONFIGURACIÓN Y NEGOCIO ---
    // Cualquier usuario logueado puede leer estas configuraciones para que la app funcione
    // Pero solo los administradores pueden modificarlas
    
    match /config/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && getRole() in ['ADMIN', 'SUPER_ADMIN'];
    }

    match /services/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && getRole() in ['ADMIN', 'SUPER_ADMIN'];
    }

    match /schedules/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && getRole() in ['ADMIN', 'SUPER_ADMIN'];
    }

    match /blockedDays/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && getRole() in ['ADMIN', 'SUPER_ADMIN'];
    }

    match /promoOffers/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && getRole() in ['ADMIN', 'SUPER_ADMIN'];
    }

    // --- CITAS / AGENDA ---
    match /appointments/{appointmentId} {
      // Lectura: Cualquier usuario logueado (para ver su agenda o la disponibilidad general)
      allow read: if isSignedIn();
      
      // Creación: Solo para uno mismo
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      
      // Actualización/Borrado: Propietario o Administradores
      allow update, delete: if isSignedIn() && (
        resource.data.customerId == request.auth.uid || 
        getRole() in ['ADMIN', 'SUPER_ADMIN']
      );
    }
  }
}
